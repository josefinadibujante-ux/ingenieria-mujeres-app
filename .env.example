# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube a git (ya está en .gitignore).

# Clave para firmar las cookies de sesión de Flask. Generá una al azar, por ej:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambiala-por-una-clave-larga-y-aleatoria

# Credenciales del panel de administración (/login).
# El formulario de login compara el campo "email" contra ADMIN_USER.
ADMIN_USER=usuario@andresbello.edu
ADMIN_PASS=una-contrasena-segura

# Ruta al archivo de credenciales de Firebase (service account).
# Local: dejá el key.json en la raíz del proyecto y podés omitir esta variable.
# Render: se sube como "Secret File" y suele quedar en /etc/secrets/key.json
GOOGLE_APPLICATION_CREDENTIALS=key.json

# Opcional: poné "production" en Render para forzar cookies seguras.
FLASK_ENV=development
